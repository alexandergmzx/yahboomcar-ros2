<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yahboomcar_localization</name>
  <version>0.1.0</version>
  <description>
    Lidar-derived odometry for the Yahboom microROS car: a scan matcher giving a movement
    estimate that is independent of the wheels and of any dead-reckoned integration, with
    explicit detection of the geometry degeneracies that make such an estimate untrustworthy.
  </description>
  <maintainer email="alexander.gomez.contact@gmail.com">Alexander Gomez</maintainer>
  <license>MIT</license>

  <!-- Declared properly, unlike the vendor packages.

       scipy is OPTIONAL. Its cKDTree makes scan matching 6.1x faster (p95 485 to 43 ms
       on real scans), which is the difference between needing decimation and a time
       budget to hold 12 Hz and not needing them. But scipy was broken on this machine
       for a while (a pip numpy shadowing apt's, with apt scipy compiled against the
       older ABI), and a localisation package that will not run because a dependency's
       dependency is mismatched is worse than one that runs slower. There is a tested
       numpy fallback, so python3-scipy is declared because it SHOULD be installed, not
       because the code stops without it. See docs/porting-notes.md. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
