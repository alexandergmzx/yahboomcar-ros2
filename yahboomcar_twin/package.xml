<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yahboomcar_twin</name>
  <version>0.1.0</version>
  <description>
    Isaac Sim digital twin support for the Yahboom microROS car: derives /joint_states
    from body twist and servo commands so the simulated robot mirrors the real one.
  </description>
  <maintainer email="alexander.gomez.contact@gmail.com">Alexander Gomez</maintainer>
  <license>MIT</license>

  <!-- Declared properly, unlike the vendor packages, so rosdep can actually resolve
       this one. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>yahboomcar_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
