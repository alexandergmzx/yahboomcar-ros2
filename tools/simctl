def launch_safety(args, dom, log, step):
    fun = getattr(args, 'fun', False)
    print(f'  {step} safety governor + deadman'
          + (' (FUN preset: obstacle braking OFF)...' if fun else '...'))
    if fun:
        # A PRESET, not a bypass: with stop/slow at 0 the obstacle stop, slow zone
        # and near-yaw gate are mathematically unreachable (min_range is always
        # > min_valid_range, so `min_range <= 0` never fires -- governor.py rules
        # 6-7), while the deadman, the stale-scan stop, the empty-sector stop and
        # the single-writer teleop discipline all stay live. Caps go to the
        # firmware-acceptance maxima (assumed, vendor keyboard defaults).
        extra = ('stop_distance:=0.0 slow_distance:=0.0 max_speed:=1.0 '
                 'max_yaw:=5.0 max_reverse_speed:=1.0')
    else:
        extra = f'max_speed:={args.max_speed}'
    sh(f'ros2 launch yahboomcar_safety safety_launch.py {extra}', dom,
       log=os.path.join(log, 'simctl-safety.log'))
