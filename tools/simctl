def launch_patrol(args, dom, log, step):
    # sim_patrol publishes /cmd_vel_raw so the governor stays in the loop, exactly as
    # it would on the floor. With --no-safety there is no governor, so NOTHING
    # forwards /cmd_vel_raw to /cmd_vel and the robot never moves -- measured: peak
    # velocity 0.000 m/s, looking for all the world like a broken simulator.
    # Without a governor the patrol must publish directly.
    if args.safety:
        print(f'  {step} governed patrol (via /cmd_vel_raw)...')
        extra = ''
    else:
