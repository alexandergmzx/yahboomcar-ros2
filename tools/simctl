def start_robot2(args, dom, log):
    """robot2 session: fake_rasptank (2d) or the Isaac twin, + the real stack.

    Same evidence discipline as the yahboom flow: wait on topics, never on a
    sleep. The stack launch (fleet_bringup robot2_sim_bringup_launch.py)
    carries matcher+EKF+SLAM itself, so there are no separate steps here.
    """
    print(f'  robot2 session, backend {args.backend}')
    procs, logs = {}, []
    if args.backend == 'isaac':
        isaac_py = os.path.expanduser('~/isaac/env_isaaclab/bin/python')
        if not os.path.exists(isaac_py):
            print(f'  Isaac python not found at {isaac_py}')
            return 2
        rt_tools = os.path.abspath(os.path.join(REPO, '..', 'rasptank-ros2', 'tools'))
        gui = ' --gui' if not args.no_isaac_gui else ''
        print('  [1/3] RaspTank Isaac twin (~90 s)...')
        twin_log = os.path.join(log, 'simctl-r2-twin.log')
        procs['rasptank_twin_runner (Isaac)'] = sh(
            f'{isaac_py} {rt_tools}/rasptank_twin_runner.py --ros{gui}', dom,
            log=twin_log)
        logs.append(twin_log)
        budget = 420
    else:
        print('  [1/3] 2D contract sim starts inside the stack launch')
        budget = 90

    print('  [2/3] robot2 stack (matcher + EKF + SLAM + safety)...')
    stack_log = os.path.join(log, 'simctl-r2-stack.log')
    procs['robot2 stack launch'] = sh(
        f'ros2 launch fleet_bringup robot2_sim_bringup_launch.py '
        f'backend:={args.backend}', dom, log=stack_log)
    logs.append(stack_log)

    print('  [3/3] waiting for evidence: /robot2/scan_filtered then /robot2/odom_laser')

    def r2_probe():
        out = subprocess.run(
            ['bash', '-c', 'source /opt/ros/jazzy/setup.bash 2>/dev/null && '
             f'ROS_DOMAIN_ID={dom} timeout 10 ros2 topic list'],
            capture_output=True, text=True).stdout
        want = [t for t in ('/robot2/scan_filtered', '/robot2/odom_laser')
                if t not in out]
        return (not want,
                'both topics advertised' if not want else f'still missing {want}')

    if not wait_for(
            f'/robot2/scan_filtered and /robot2/odom_laser advertised on domain {dom}',
            r2_probe, budget, procs, logs):
        return 1
    print('  up. ./tools/simctl estop --domain', dom, ' to zero;  stop to tear down')
    return 0


