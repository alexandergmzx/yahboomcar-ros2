def sh(cmd, domain, background=True, log=None):
    """Run a command with ROS sourced, in its own process group."""
    full = (f'source /opt/ros/jazzy/setup.bash && source {WS_SETUP} && '
            f'export ROS_DOMAIN_ID={domain} && {cmd}')
    out = open(log, 'w') if log else subprocess.DEVNULL
    p = subprocess.Popen(['bash', '-c', full], start_new_session=True,
                         stdout=out, stderr=subprocess.STDOUT)
    if not background:
        p.wait()
    return p


def ros_eval(snippet, domain, timeout=40):
    """Run a small rclpy snippet and return its stdout. Keeps ROS out of this file."""
    code = ('import os,sys,time,threading\n'
            f'os.environ["ROS_DOMAIN_ID"]="{domain}"\n'
            'import rclpy\n'
            'from rclpy.node import Node\n'
            'from rclpy.executors import SingleThreadedExecutor\n'
            'from rclpy.qos import qos_profile_sensor_data\n'
            + snippet)
    full = f'source /opt/ros/jazzy/setup.bash && source {WS_SETUP} && python3 -'
    try:
        r = subprocess.run(['bash', '-c', full], input=code, capture_output=True,
                           text=True, timeout=timeout)
        return r.stdout
    except subprocess.TimeoutExpired:
        return ''


def node_names(domain):
    out = ros_eval(
        'rclpy.init(); n=Node("simctl_probe"); time.sleep(2.5)\n'
        'print("|".join(sorted(x for x,_ in n.get_node_names_and_namespaces())))\n'
        'sys.stdout.flush(); os._exit(0)\n', domain, timeout=30)
    return [x for x in out.strip().split('|') if x]


def zero_domain(domain, seconds=2.5):
    """Publish zeros to /cmd_vel and /cmd_vel_raw, then report the observed speed."""
    return ros_eval(
        'from geometry_msgs.msg import Twist\n'
        'from nav_msgs.msg import Odometry\n'
        'rclpy.init(); n=Node("simctl_stop"); v=[]\n'
        'n.create_subscription(Odometry,"/odom_raw",lambda m: v.append(m.twist.twist.linear.x), qos_profile_sensor_data)\n'
        'a=n.create_publisher(Twist,"/cmd_vel",10); b=n.create_publisher(Twist,"/cmd_vel_raw",10)\n'
        # robot2 sessions (fleet session 5): same zeros, its namespace.
        'c=n.create_publisher(Twist,"/robot2/cmd_vel",10); d=n.create_publisher(Twist,"/robot2/cmd_vel_raw",10)\n'
        'ex=SingleThreadedExecutor(); ex.add_node(n); threading.Thread(target=ex.spin,daemon=True).start()\n'
        'time.sleep(1.0)\n'
        f'end=time.time()+{seconds}\n'
        'while time.time()<end:\n'
        '    a.publish(Twist()); b.publish(Twist()); c.publish(Twist()); d.publish(Twist()); time.sleep(0.04)\n'
        'time.sleep(0.6)\n'
        'print("VX", v[-1] if v else "nodata")\n'
        'sys.stdout.flush(); os._exit(0)\n', domain, timeout=30)


def domain_of(pid):
    """ROS_DOMAIN_ID of a running process, from /proc/<pid>/environ. None if unknown.

    A process's domain is NOT visible in `ps args`, which is why this used to match on
    the command line alone -- see running().
    """
    try:
        with open(f'/proc/{pid}/environ', 'rb') as f:
            for entry in f.read().split(b'\0'):
                if entry.startswith(b'ROS_DOMAIN_ID='):
                    return int(entry.split(b'=', 1)[1] or 0)
    except (OSError, ValueError):
        return None
    # ROS 2 treats an unset ROS_DOMAIN_ID as 0.
    return 0


def running(patterns, domain=None):
    """PIDs whose command line matches any pattern. Never matches simctl itself.

    `domain` RESTRICTS the match to processes actually on that ROS domain. Without it
    this matched on command line alone, and SIM_PROCS contains `cmd_vel_governor` and
    `cmd_vel_deadman` -- so `simctl stop` would kill the PHYSICAL safety layer while
    printing "the car gets ZEROS ONLY, its agent and nodes are never killed". Stripping
    the car's only protection while claiming not to touch it is the worst version of
    this mistake. Audit finding.

    A process whose domain cannot be read (permissions, already exited) is SKIPPED when
    a domain is specified: refusing to kill something unidentified is the safe default
    when the thing you might be killing is a robot's deadman.
    """
    me = os.getpid()
    out = subprocess.run(['ps', '-eo', 'pid,args'], capture_output=True, text=True).stdout
    pids = []
    for line in out.splitlines()[1:]:
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        pid, args = int(parts[0]), parts[1]
        if pid == me or 'simctl' in args or 'micro_ros_agent' in args:
            continue
        if not any(pat in args for pat in patterns):
            continue
        if domain is not None and domain_of(pid) != domain:
            continue
        pids.append(pid)
    return pids


