                  'directly)...')
            extra = ' --direct'
        sh(f'python3 {REPO}/tools/sim_patrol.py --domain {dom}{extra}', dom,
           log=os.path.join(log, 'simctl-patrol.log'))
        time.sleep(6)

    print()
    print('  up. ./tools/simctl status   to inspect,   ./tools/simctl stop   to tear down')
    return 0


# ------------------------------------------------------------------------- stop
def cmd_stop(args):
    print('=== simctl stop ===')

    # STEP 1: silence whatever is COMMANDING motion. Zeroing first does not work -- a
    # driver republishing at 20 Hz just overrides the zeros. Measured: the stop step
    # reported vx = 0.18 because the patrol was still commanding, and the robot only
    # halted when it was killed afterwards, which is precisely the accident this
    # ordering is meant to prevent.
    print('  [1/5] silencing command sources (they would republish over the zeros)')
    src = running(COMMAND_SOURCES, domain=args.domain)
    for p in src:
        try:
            os.kill(p, signal.SIGTERM)          # SIGTERM first: sim_patrol zeroes on it
        except ProcessLookupError:
            pass
    time.sleep(2.5)
    for p in running(COMMAND_SOURCES, domain=args.domain):
        try:
            os.kill(p, signal.SIGKILL)
        except ProcessLookupError:
            pass
    print(f'        {len(src)} command source(s) stopped')

    # STEP 2: now the zeros can actually land, and the governor (still alive) holds them.
    print('  [2/5] stopping the robots, and verifying they are at rest')
    for dom, label in ((args.domain, 'simulation'), (CAR_DOMAIN, 'real car')):
        if dom == CAR_DOMAIN and args.no_car:
            print(f'        domain {dom} ({label}): skipped (--no-car)')
            continue
        out = zero_domain(dom, seconds=3.0)
        vx = out.split('VX')[-1].strip() if 'VX' in out else 'no response'
        # THREE states, not two. "nodata" used to fall through the float() parse into
        # moving=False and print "at rest" -- but no /odom_raw samples means NOBODY
        # OBSERVED THE ROBOT, which on an empty domain is fine and on a live one means
        # the witness failed. Absence of evidence is reported as UNKNOWN, never as a
        # verified stop. Audit finding.
        try:
            moving = abs(float(vx)) > 0.02
            state = 'STILL MOVING' if moving else 'at rest (observed)'
        except ValueError:
            moving = False
            state = ('nothing on this domain answered -- UNKNOWN, not verified at rest'
                     if vx in ('nodata', 'no response') else f'unparseable: {vx!r}')
        print(f'        domain {dom} ({label}): vx = {vx}  -> {state}')
        if moving:
            print('        *** retrying: something is still commanding motion ***')
            out = zero_domain(dom, seconds=4.0)
            vx = out.split('VX')[-1].strip() if 'VX' in out else '?'
            print(f'        domain {dom} ({label}): vx = {vx} after retry')
    if not args.no_car:
        print('        (the car gets ZEROS ONLY -- its agent and nodes are never killed)')
        print(f'        every kill below is filtered to ROS_DOMAIN_ID={args.domain}, so a '
              f'governor')
        print(f'        or deadman running on {CAR_DOMAIN} is left alone)')

    print('  [3/5] killing simulation processes')
    pids = running(SIM_PROCS, domain=args.domain)
    for p in pids:
        try:
            os.kill(p, signal.SIGTERM)
        except ProcessLookupError:
            pass
    time.sleep(3)
    left = running(SIM_PROCS, domain=args.domain)
    for p in left:
        try:
            os.kill(p, signal.SIGKILL)
        except ProcessLookupError:
            pass
    time.sleep(1)
    print(f'        {len(pids)} terminated, '
          f'{len(running(SIM_PROCS, domain=args.domain))} remaining '
          f'(domain {args.domain} only)')

    # Stale segments silently block new DDS participants: nodes just never appear.
    print('  [4/5] clearing stale DDS shared memory')
    seg = stale_segments()
    for f in seg:
        try:
            os.unlink(f)
        except OSError:
            pass
    print(f'        {len(seg)} segments removed, {len(stale_segments())} left')

    print('  [5/5] resetting the ros2 daemon (it caches a stale node list)')
    subprocess.run(['bash', '-c',
                    'source /opt/ros/jazzy/setup.bash && ros2 daemon stop'],
                   capture_output=True)
    print()
    print('  stopped.')
    return 0


# ----------------------------------------------------------------------- status
def cmd_status(args):
    print('=== simctl status ===')
    for dom, label in ((args.domain, 'simulation'), (CAR_DOMAIN, 'real car')):
        names = node_names(dom)
        kind = ('SIMULATOR' if 'fake_robot' in names else
                'REAL ROBOT' if 'YB_Car_Node' in names else 'nothing')
        print(f'  domain {dom} ({label}): {kind}, {len(names)} nodes')
        for want, why in (('cmd_vel_governor', 'speed/obstacle limiting'),
                          ('cmd_vel_deadman', 'catches a dead publisher'),
                          ('slam_toolbox', 'mapping'),
                          ('laser_odometry', 'lidar odometry'),
                          ('ekf_filter_node', 'sensor fusion')):
            if want in names:
                print(f'      {want:20s} up   ({why})')
    print(f'  rviz2 instances: {len(running(["rviz2"]))}')
    print(f'  stale DDS segments: {len(stale_segments())}')
    out = ros_eval(
        'from nav_msgs.msg import Odometry\n'
        'rclpy.init(); n=Node("simctl_status"); p=[]\n'
        'n.create_subscription(Odometry,"/odom",lambda m: p.append((m.pose.pose.position.x,m.pose.pose.position.y)),10)\n'
        'ex=SingleThreadedExecutor(); ex.add_node(n); threading.Thread(target=ex.spin,daemon=True).start()\n'
        'time.sleep(3)\n'
        'print("POSE", ("%.2f %.2f" % p[-1]) if p else "none")\n'
        'sys.stdout.flush(); os._exit(0)\n', args.domain, timeout=30)
    if 'POSE' in out:
        print(f'  robot pose (/odom): {out.split("POSE")[-1].strip()}')
    return 0


def cmd_patrol(args):
    return sh(f'python3 {REPO}/tools/sim_patrol.py --domain {args.domain}',
              args.domain, background=False).returncode


def sim_target(domain):
    """-> 'hardware' | 'simulator' | 'nothing'. Same evidence rules as the shared guard.

    A simulator is recognised by POSITIVE evidence, two ways: the `fake_robot` node
    (2D backend), or the /sim/ground_truth topic -- because the ISAAC backend advertises
    no ROS nodes at all, which is how the patrol once refused a healthy simulator while
    everything else looked fine. Hardware always wins: if YB_Car_Node is present, this is
    the car's domain no matter what else is on it.
    """
    # Same asymmetric exit as tools/_cmd_vel_safety.target_of(): DDS discovery is
    # incremental, so finding a simulator FIRST must not end the search -- the car may
    # be discovered seconds later. Hardware evidence ends it immediately (the conclusion
    # is refusal); simulator evidence starts a 6 s confirmation dwell watching for the
    # car. A single 2.5 s look here was the fail-open version. Audit finding.
    out = ros_eval(
        'rclpy.init(); n=Node("simctl_target")\n'
        'real=sim=False; sim_at=None; end=time.time()+14.0\n'
        'while time.time()<end:\n'
        '    time.sleep(1.0)\n'
        '    names=[x for x,_ in n.get_node_names_and_namespaces()]\n'
        '    topics=[t for t,_ in n.get_topic_names_and_types()]\n'
        '    real="YB_Car_Node" in names\n'
        '    sim="fake_robot" in names or "/sim/ground_truth" in topics\n'
        '    if real: break\n'
        '    if sim:\n'
        '        if sim_at is None: sim_at=time.time()\n'
        '        elif time.time()-sim_at>=6.0: break\n'
        'print("TARGET", "hardware" if real else "simulator" if sim else "nothing")\n'
        'sys.stdout.flush(); os._exit(0)\n', domain, timeout=40)
    return out.split('TARGET')[-1].strip() if 'TARGET' in out else 'nothing'


def cmd_teleop(args):
    """The vendor's own keyboard -- u i o / j k l / m , . -- against the simulator.

    Runs `ros2 run yahboomcar_ctrl yahboom_keyboard` UNMODIFIED, in the foreground with
    the terminal attached (it reads keys via termios, so it cannot live in the background
    behind a log file the way everything else simctl starts does).

    If the governor is running on the domain, the keyboard is remapped onto /cmd_vel_raw
    so the governor stays in the loop, exactly as safe_teleop_launch.py does on the real
    robot. Without a governor the remap would drive nothing -- /cmd_vel_raw has no
    forwarder -- so it publishes /cmd_vel directly, which is the bare vendor behaviour.
    """
    print(f'=== simctl teleop  (domain {args.domain}) ===')
    # Structural refusal first; discovery second. See cmd_start for why.
    if args.domain == CAR_DOMAIN:
        print(f'REFUSED: domain {args.domain} is the CAR\'S domain, structurally')
        print('  off-limits to simulator teleop. For hardware use the governed launch:')
        print('    ros2 launch yahboomcar_safety safe_teleop_launch.py')
        return 2
    target = sim_target(args.domain)
    if target == 'hardware':
        print('REFUSED: YB_Car_Node is on this domain -- this is the REAL robot.')
        print('  For hardware teleop use the governed launch instead:')
        print('    ros2 launch yahboomcar_safety safe_teleop_launch.py')
        return 2
    if target == 'nothing':
        print('No simulator on this domain. Start one first:')
        print('  ./tools/simctl start --no-patrol')
        return 2

    # TELEOP MUST OWN THE DOMAIN. Field report: teleop was started with the patrol
    # still running (simctl start starts one by default), the two interleaved on
    # /cmd_vel_raw, the governor forwarded both, and the car "kept moving forward" no
    # matter what was pressed -- the patrol simply out-published the keys. Same
    # silence-the-sources-first pattern as cmd_stop step 1, for the same reason:
    # zeroing under a live publisher just gets republished over.
    rivals = running(COMMAND_SOURCES, domain=args.domain)
    if rivals:
        print(f'  silencing {len(rivals)} competing command source(s) -- two '
              'controllers interleave,')
        print('  and the firmware model latches whichever command lands last:')
        for pid in rivals:
            try:
                with open(f'/proc/{pid}/cmdline', 'rb') as f:
                    name = f.read().split(b'\0')[1:2]
                print(f'    pid {pid}  {name[0].decode() if name else "?"}')
            except OSError:
                print(f'    pid {pid}')
            try:
                os.kill(pid, signal.SIGTERM)     # patrol zeroes on SIGTERM
            except ProcessLookupError:
                pass
        time.sleep(2.5)
        for pid in running(COMMAND_SOURCES, domain=args.domain):
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        # Clear anything they latched before the keyboard takes over.
        zero_domain(args.domain, seconds=2.0)
        print('  silenced; the keyboard is now the only command source')

    gov_up = bool(running(['cmd_vel_governor'], domain=args.domain))
    if args.direct and gov_up:
        # REFUSE, measured: with a governor alive, --direct interleaves with the
        # governor's stale-command zeros on /cmd_vel -- an audit reproduced 44 odometry
        # samples alternating 25 stopped / 19 moving during a single direct command.
        # Two writers on one topic is the exact defect teleop exists to prevent.
        print('REFUSED: --direct while a governor is running on this domain.')
        print('  The governor also publishes /cmd_vel (its stale-command rule emits')
        print('  zeros), so your direct commands and its zeros interleave -- measured')
        print('  as the robot stuttering between stopped and moving. Either:')
        print('    * drop --direct (governed teleop, the normal path), or')
        print('    * restart without the safety layer:')
        print('        ./tools/simctl stop && ./tools/simctl start --no-patrol --no-safety')
        return 2
    governed = not args.direct and gov_up
    if governed:
        print('  governor detected: keys go to /cmd_vel_raw, governed onto /cmd_vel')
        # The LIVE cap, not the default -- printing "0.35" while the governor ran at
        # 1.0 was misleading in the first test of this very feature.
        cap = ros_eval(
            'rclpy.init(); n=Node("cap_probe")\n'
            'from rcl_interfaces.srv import GetParameters\n'
            'c=n.create_client(GetParameters,"/cmd_vel_governor/get_parameters")\n'
            'r=None\n'
            'if c.wait_for_service(timeout_sec=4.0):\n'
            '    req=GetParameters.Request(); req.names=["max_speed"]\n'
            '    f=c.call_async(req)\n'
            '    rclpy.spin_until_future_complete(n,f,timeout_sec=4.0)\n'
            '    r=f.result()\n'
            'print("CAP", r.values[0].double_value if r and r.values else "?")\n'
            'sys.stdout.flush(); os._exit(0)\n', args.domain, timeout=20)
        cap = cap.split('CAP')[-1].strip() if 'CAP' in cap else '?'
        print(f'  SPEED: keyboard starts at 0.2 m/s, q raises 10% per press; the')
        print(f'  governor caps at max_speed = {cap} m/s (this session).')
        print('  PRESS q SLOWLY -- the vendor node flushes its input queue between')
        print('  reads (tty.setraw/TCSAFLUSH), so rapid presses are silently dropped.')
        print('  For a faster session: simctl start --no-patrol --max-speed 1.0,')
        print('  or bypass the governor:  simctl teleop --direct')
        remap = ' --ros-args -r cmd_vel:=/cmd_vel_raw'
    else:
        why = '--direct' if args.direct else 'no governor running'
        print(f'  publishing /cmd_vel directly ({why}) -- bare vendor behaviour')
        print('  SPEED: keyboard starts at 0.2 m/s; q raises 10% per press up to 1.0,')
        print('  and the simulated firmware accepts up to 1.0 m/s (assumed, unmeasured).')
        remap = ''
    print('  Ctrl+C to stop; the robot is left stationary.')
    print()

    # Foreground, with the TTY fully inherited: stdin for the keys, stdout for the
    # vendor's own help text. sh() would swallow both.
    full = (f'source /opt/ros/jazzy/setup.bash && source {WS_SETUP} && '
            f'export ROS_DOMAIN_ID={args.domain} && '
            f'ros2 run yahboomcar_ctrl yahboom_keyboard{remap}')
    rc = subprocess.run(['bash', '-c', full]).returncode
    # The vendor's finally publishes ONE zero; make the stop stick regardless of what
    # state the node died in. Zeros only -- same fail-safe direction as everything here.
    zero_domain(args.domain, seconds=2.0)
    print('\n  teleop ended; zeros published')
    return rc


def cmd_estop(args):
    """Explicit, so stopping the car is never a side effect of tidying up."""
    print(f'=== simctl estop  (domain {args.domain}) ===')
    out = zero_domain(args.domain, seconds=4.0)
    vx = out.split('VX')[-1].strip() if 'VX' in out else 'no response'
    print(f'  zeros sent, vx = {vx}')
    print('  NOTE: this stops a robot that is listening. It cannot stop one whose link')
    print('  is down -- the firmware has no watchdog, so the power switch is the only')
    print('  stop that always works.')
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    sub = ap.add_subparsers(dest='cmd', required=True)

    s = sub.add_parser('start', help='bring up a simulation')
    s.add_argument('--backend', choices=['2d', 'isaac'], default='2d',
                   help='2d is instant and has no physics; isaac has real\n                         contact physics and collisions, takes ~90 s, and\n                         needs the GPU')
    s.add_argument('--no-isaac-gui', action='store_true',
                   help='run Isaac headless. Without this a window opens --\n                         seeing it is most of why you would pick Isaac.')
    s.add_argument('--domain', type=int, default=SIM_DOMAIN)
    s.add_argument('--slip', type=float, default=0.0)
    s.add_argument('--max-speed', type=float, default=0.35,
                   help='governor forward cap, m/s. Default mirrors the floor\n                         safety value; raise for a faster sim session, e.g. 1.0.\n                         The sim firmware itself accepts up to 1.0 (assumed).')
    s.add_argument('--no-rviz', dest='rviz', action='store_false')
    s.add_argument('--no-slam', dest='slam', action='store_false')
    s.add_argument('--no-safety', dest='safety', action='store_false')
    s.add_argument('--no-patrol', dest='patrol', action='store_false')
    s.set_defaults(func=cmd_start)

    t = sub.add_parser('stop', help='stop robots, then tear the simulation down')
    t.add_argument('--domain', type=int, default=SIM_DOMAIN)
    t.add_argument('--no-car', action='store_true',
                   help='do not send stop-zeros to the real car')
    t.set_defaults(func=cmd_stop)

    st = sub.add_parser('status', help='what is running, and where')
    st.add_argument('--domain', type=int, default=SIM_DOMAIN)
    st.set_defaults(func=cmd_status)

    tp = sub.add_parser('teleop',
                        help="drive the sim with Yahboom's own keyboard (u i o / j k l)")
    tp.add_argument('--domain', type=int, default=SIM_DOMAIN)
    tp.add_argument('--direct', action='store_true',
                    help='publish /cmd_vel even if a governor is running')
    tp.set_defaults(func=cmd_teleop)

    p = sub.add_parser('patrol', help='drive an already-running simulation')
    p.add_argument('--domain', type=int, default=SIM_DOMAIN)
    p.set_defaults(func=cmd_patrol)

    e = sub.add_parser('estop', help='publish zeros to a domain, explicitly')
    e.add_argument('--domain', type=int, default=CAR_DOMAIN)
    e.set_defaults(func=cmd_estop)

    args = ap.parse_args()
    return args.func(args)


if __name__ == '__main__':
    code = main()
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(code)
