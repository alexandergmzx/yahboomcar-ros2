def _tail(path, n=15):
    try:
        with open(path) as f:
            return ''.join(f.readlines()[-n:]).rstrip()
    except OSError:
        return f'    (no log at {path})'


def wait_for(condition, probe, seconds, procs, logs, poll_gap=5):
    """Wait for `probe` to report ready, or fail LOUDLY. Never silently.

    Every failure names the unmet CONDITION and the log to read. `procs` are the
    backend processes this wait depends on: one of them exiting fails the wait
    IMMEDIATELY. Before this existed, the isaac wait polled topics for its full
    420 s budget against a sim_runner that had exited in under a second (stale
    post-extraction path), which is indistinguishable from a hang to anyone
    watching -- reported as "waits indefinitely". Repair finding, 2026-08-08.

    `probe` -> (ready, detail). `detail` is printed either way, so the failure
    message says what WAS observed, not just what wasn't.
    """
    t0 = time.time()
    detail = 'no probe completed'
    while time.time() - t0 < seconds:
        dead = [(name, p.returncode) for name, p in procs.items()
                if p is not None and p.poll() is not None]
        if dead:
            print(f'  FAILED after {time.time()-t0:.0f} s waiting for: {condition}')
            for name, rc in dead:
                print(f'    backend process {name!r} EXITED (code {rc}) -- the wait '
                      'cannot succeed.')
            for lg in logs:
                print(f'    --- {lg} (last lines) ---')
                print(_tail(lg))
            return False
        time.sleep(poll_gap)
        ready, detail = probe()
        if ready:
            print(f'        {detail}   ({time.time()-t0:.0f} s)')
            return True
    print(f'  FAILED: {condition}')
    print(f'    unmet after the {seconds:.0f} s budget. Last probe: {detail}')
    for lg in logs:
        print(f'    --- {lg} (last lines) ---')
        print(_tail(lg))
    return False


def probe_topics(dom, subs):
    """Count messages on topics for ~4 s. subs = [(topic, msg, sensor_qos?)].
    -> (all topics saw >10 msgs, human-readable counts)."""
    imports = ('from sensor_msgs.msg import LaserScan\n'
               'from nav_msgs.msg import Odometry\n')
    body = 'rclpy.init(); n=Node("simctl_wait"); c={}\n'
    for i, (topic, msg, sensor) in enumerate(subs):
        qos = 'qos_profile_sensor_data' if sensor else '10'
        body += (f'c[{i}]=[0]\n'
                 f'n.create_subscription({msg},"{topic}",'
                 f'lambda m,k=c[{i}]: k.__setitem__(0,k[0]+1), {qos})\n')
    body += ('ex=SingleThreadedExecutor(); ex.add_node(n); '
             'threading.Thread(target=ex.spin,daemon=True).start()\n'
             'time.sleep(4)\n'
             'print("COUNTS", ",".join(str(c[i][0]) for i in sorted(c)))\n'
             'sys.stdout.flush(); os._exit(0)\n')
    out = ros_eval(imports + body, dom, timeout=30)
    if 'COUNTS' not in out:
        return False, 'probe produced no output (DDS trouble? stale shm?)'
    counts = out.split('COUNTS')[-1].strip().split(',')
    pairs = ', '.join(f'{t}: {n}' for (t, _, _), n in zip(subs, counts))
    try:
        ready = all(int(x) > 10 for x in counts)
    except ValueError:
        return False, f'unparseable probe output {out!r}'
    return ready, f'{pairs} msgs in 4 s'


