def wait_map(dom, log):
    # slam_toolbox is a LIFECYCLE node on Jazzy: it starts unconfigured and, without
    # the lifecycle manager driving it, reads its params and then silently does
    # nothing forever. So readiness has to be checked -- but NOT with
    # `ros2 lifecycle get`, which reported "Node not found" on this machine while
    # SLAM was demonstrably publishing a 4.04 x 4.04 m map. The CLI depends on the
    # ros2 daemon, and the daemon is unreliable here after processes churn.
    #
    # Wait for /map instead. It is the output that matters, it cannot be stale, and
    # it proves more than `active` does: a node can be active and still produce
    # nothing.
    print('        waiting for /map (checking output, not status)...')
    deadline = time.time() + 120
    while time.time() < deadline:
        time.sleep(6)
        out = ros_eval(
            'from rclpy.qos import QoSProfile, QoSDurabilityPolicy, QoSReliabilityPolicy\n'
            'from nav_msgs.msg import OccupancyGrid\n'
            'rclpy.init(); n=Node("simctl_map"); g=[]\n'
            'q=QoSProfile(depth=1, durability=QoSDurabilityPolicy.TRANSIENT_LOCAL,'
            ' reliability=QoSReliabilityPolicy.RELIABLE)\n'
            'n.create_subscription(OccupancyGrid,"/map",lambda m: g.append(m), q)\n'
            'ex=SingleThreadedExecutor(); ex.add_node(n); threading.Thread(target=ex.spin,daemon=True).start()\n'
            'time.sleep(5)\n'
            'print("MAP", len(g), ("%.2f" % (g[-1].info.width*g[-1].info.resolution)) if g else 0)\n'
            'sys.stdout.flush(); os._exit(0)\n', dom, timeout=30)
        if 'MAP' in out and out.split('MAP')[-1].split()[0] != '0':
            n, size = out.split('MAP')[-1].split()[:2]
            print(f'        map publishing: {n} updates, {size} m across')
            break
    else:
        print('        WARNING: no /map after 120 s. SLAM is not producing output.')
        print(f'        Look at {os.path.join(log, "simctl-slam.log")}')


