                'ex=SingleThreadedExecutor(); ex.add_node(n); threading.Thread(target=ex.spin,daemon=True).start()\n'
                'time.sleep(5)\n'
                'print("MAP", len(g), ("%.2f" % (g[-1].info.width*g[-1].info.resolution)) if g else 0)\n'
                'sys.stdout.flush(); os._exit(0)\n', dom, timeout=30)
